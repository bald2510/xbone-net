\@writefile{lot}{\contentsline {table}{\numberline {2.2}{\ignorespaces Bảng tổng hợp nguyên lý của các phương pháp tiền huấn luyện mô hình ngôn ngữ trực quan}}{14}{table.2.2}\protected@file@percent }
\newlabel{tab:VLMPretrainingPrinciple}{{2.2}{14}{Bảng tổng hợp nguyên lý của các phương pháp tiền huấn luyện mô hình ngôn ngữ trực quan}{table.2.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2.3}{\ignorespaces Bảng tổng hợp chiến lược, mục tiêu và phương pháp tiền huấn luyện của các mô hình ngôn ngữ trực quan. Trong đó, CL (Contrastive Learning): Học tương phản; GCL (Global Contrastive Learning): Học tương phản toàn cục; LCL (Local Contrastive Learning): Học tương phản cục bộ; MIM (Masked Image Modeling): Mô hình hóa hình ảnh có che giấu; MLM (Masked Language Modeling): Mô hình hóa ngôn ngữ có che giấu; ITM (Image-Text Matching): Ghép nối ảnh - văn bản;}}{15}{table.2.3}\protected@file@percent }
\newlabel{tab:VLMPretrainingMethod}{{2.3}{15}{Bảng tổng hợp chiến lược, mục tiêu và phương pháp tiền huấn luyện của các mô hình ngôn ngữ trực quan. Trong đó, CL (Contrastive Learning): Học tương phản; GCL (Global Contrastive Learning): Học tương phản toàn cục; LCL (Local Contrastive Learning): Học tương phản cục bộ; MIM (Masked Image Modeling): Mô hình hóa hình ảnh có che giấu; MLM (Masked Language Modeling): Mô hình hóa ngôn ngữ có che giấu; ITM (Image-Text Matching): Ghép nối ảnh - văn bản;}{table.2.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2.4}{\ignorespaces Bảng tổng hợp kết quả của các phương pháp tiền huấn luyện mô hình ngôn ngữ trực quan}}{16}{table.2.4}\protected@file@percent }
