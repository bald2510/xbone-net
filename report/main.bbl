    \field{title}{Exploring low-resource medical image classification with
  weakly supervised prompt learning}
    \verb{url}
    \verb https://www.sciencedirect.com/science/article/pii/S0031320324000013
    \endverb
    \field{volume}{149}
    \field{journaltitle}{Pattern Recognition}
    \field{year}{2024}
  \endentry

